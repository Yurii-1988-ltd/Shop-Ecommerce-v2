@page "/auth/account"

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>My Account</PageTitle>

<AuthorizeView>

    <Authorized>

        <section class="account-page">

            <div class="account-header">

                <div>
                    <span class="account-eyebrow">
                        ACCOUNT
                    </span>

                    <h1>My Account</h1>

                    <p>
                        Manage your account and orders.
                    </p>
                </div>

            </div>


            <div class="account-grid">

                <div class="account-card account-card--profile">

                    <div class="account-card__header">

                        <div class="account-avatar">
                            @GetInitials(context.User)
                        </div>

                        <div>
                            <h2>
                                @GetDisplayName(context.User)
                            </h2>

                            <span>
                                @context.User.FindFirstValue(ClaimTypes.Email)
                            </span>
                        </div>

                    </div>

                    <div class="account-card__body">

                        <div class="account-info">
                            <span>Account ID</span>

                            <strong>
                                @context.User.FindFirstValue(
                                    ClaimTypes.NameIdentifier)
                            </strong>
                        </div>

                    </div>

                </div>


                <a href="/orders" class="account-card account-link">

                    <div class="account-link__icon">
                        📦
                    </div>

                    <div>
                        <h2>My Orders</h2>

                        <p>
                            View your order history and track deliveries.
                        </p>
                    </div>

                    <span class="account-link__arrow">
                        →
                    </span>

                </a>


                <a href="/cart" class="account-card account-link">

                    <div class="account-link__icon">
                        🛒
                    </div>

                    <div>
                        <h2>Shopping Cart</h2>

                        <p>
                            Review the products in your cart.
                        </p>
                    </div>

                    <span class="account-link__arrow">
                        →
                    </span>

                </a>


                <div class="account-card">

                    <div class="account-link__icon">
                        ⚙️
                    </div>

                    <div>
                        <h2>Account settings</h2>

                        <p>
                            Manage your personal information and preferences.
                        </p>
                    </div>

                </div>

            </div>

        </section>

    </Authorized>


    <NotAuthorized>

        <section class="account-unauthorized">

            <div class="account-unauthorized__icon">
                🔐
            </div>

            <h1>Sign in required</h1>

            <p>
                Sign in to access your account.
            </p>

            <a href="/login" class="account-button">
                Sign in
            </a>

        </section>

    </NotAuthorized>

</AuthorizeView>


@code {

    private static string GetDisplayName(ClaimsPrincipal user)
    {
        return user.FindFirstValue(ClaimTypes.Email)
            ?? "Customer";
    }

    private static string GetInitials(ClaimsPrincipal user)
    {
        var email = user.FindFirstValue(ClaimTypes.Email);

        if (string.IsNullOrWhiteSpace(email))
            return "U";

        return email[..1].ToUpperInvariant();
    }
}